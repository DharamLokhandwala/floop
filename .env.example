# Database (local: SQLite)
DATABASE_URL="file:./dev.db"

# Production: Turso (set both; app uses Turso when present)
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN=""

# NextAuth (required for sign-in)
NEXTAUTH_SECRET="your-secret-at-least-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Isolated, cookie-less origin for proxied reviewed websites.
# In development, use 127.0.0.1 so it is a different origin from localhost.
# In production, point a separate hostname at the same deployment, e.g.
# https://viewer.floop.design. It MUST differ from NEXTAUTH_URL.
NEXT_PUBLIC_VIEWER_ORIGIN="http://127.0.0.1:3000"

# Resend (for magic-link emails)
RESEND_API_KEY="re_xxxx"
# RESEND_FROM="noreply@yourdomain.com"

# Optional: Claude / public Blob store (for analysis and screenshots)
# ANTHROPIC_API_KEY=""
# BLOB_READ_WRITE_TOKEN=""

# ElevenLabs Scribe (for voice comment transcription)
# ELEVENLABS_API_KEY=""
